# Discord Developer Portal -> Bot -> token. Jangan bagikan token.
DISCORD_TOKEN=PASTE_DISCORD_BOT_TOKEN
GUILD_ID=PASTE_DISCORD_SERVER_ID
ALERT_CHANNEL_ID=PASTE_ALERT_CHANNEL_ID

# Upstash Redis REST API (Upstash Console → database → REST API)
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=PASTE_UPSTASH_REST_TOKEN
REDIS_PREFIX=bybit_signal_bot

SCAN_INTERVAL_SECONDS=120
MAX_SCAN_SYMBOLS=25
SCAN_TIMEFRAMES=5,15
MIN_SIGNAL_SCORE=65
SIGNAL_STRATEGY=adaptive
ACTIVE_FILTER=1
REGIME_TREND_ADX=23
REGIME_RANGE_ADX=20
SWING_LOOKBACK=12
TP_R=1.5
FEE_PCT=0.11
SLIPPAGE_PCT=0.04
FUNDING_ESTIMATE=1
BREAKOUT_LOOKBACK=20
BREAKOUT_RETEST_BARS=3
BREAKOUT_MIN_VOLUME=1.1
BB_RSI_OVERSOLD=35
BB_RSI_OVERBOUGHT=65
BB_MAX_ADX_30M=25
MIN_TURNOVER_24H=5000000
SIGNAL_MAX_AGE_MINUTES=180
COOLDOWN_MINUTES=30

# Public URL for the live web dashboard (Railway → Settings → Networking → Public Domain)
# Example: https://your-app.up.railway.app
DASHBOARD_BASE_URL=https://YOUR-APP.up.railway.app
# Optional separate signing secret; if omitted, the Discord token is used to sign private dashboard links
DASHBOARD_SECRET=SET_A_LONG_RANDOM_SECRET
